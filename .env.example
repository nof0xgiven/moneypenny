# Optional: Homey home control. Leave unset to run without it (the app still
# starts; home-control commands get a spoken "not set up" response).
#HOMEY_BASE_URL=http://homey.local
#HOMEY_API_KEY=changeme

WEATHER_LAT=25.2048
WEATHER_LON=55.2708

# Optional: Moneypenny's own voice (PersonaPlex voice prompt). Legal values:
# NATF0-NATF3, NATM0-NATM3 (natural female/male), VARF0-VARF4, VARM0-VARM4 (varied).
#MONEYPENNY_VOICE=NATF2

# Optional: the briefing "earpiece" voice (Kokoro), heard only by the model.
# Keep it clearly distinct from the user's voice (docs/decisions/0001).
# am_michael is the spike-proven choice; other Kokoro voices (e.g. af_heart,
# bm_george, bf_emma, am_adam) are untested here.
#BRIEFING_VOICE=am_michael

# Acoustic echo cancellation on the mic path (speex; needs `brew install
# speexdsp`, degrades gracefully without it). Default on. Set 0 to disable,
# e.g. on a headphone setup or when isolating AEC during debugging.
#ECHO_CANCEL=1
